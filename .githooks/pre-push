#!/usr/bin/env bash
# Block direct pushes to main. Feature branches and tags are allowed.
set -euo pipefail

protected_ref="refs/heads/main"
blocked=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [[ "$remote_ref" == "$protected_ref" ]] || continue

  if [[ "$local_sha" =~ ^0+$ ]]; then
    printf '\n✖ pre-push: deleting main is forbidden\n' >&2
  else
    printf '\n✖ pre-push: direct pushes to main are forbidden\n' >&2
  fi
  printf '  Push the branch and open a pull request: scripts/mr.sh\n' >&2
  blocked=1
done

exit "$blocked"
